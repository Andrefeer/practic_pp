Kotlin: Sa se creeze in Kotlin un program care sa descarce o pagina HTML< o analizeaza cu modulul Jsoup si salveaza separat toate imaginile grafice din el. Se vor cauta tag-uri de tip ‘img’ si 
se va extrage valoarea atributului src( sursa imaginii respective), pe baza careia poate fi descarcata imaginea cu cererea GET

                                                      main:

import org.jsoup.Jsoup
import java.io.File
import java.net.URL
import kotlin.io.readBytes
fun main() {

    val doc = Jsoup.connect("https://commons.wikimedia.org/wiki/Category:Cats")
        .userAgent("Mozilla/5.0")
        .get()

    var i = 0
    val images = doc.select("img")

    for (img in images) {

        val url = img.absUrl("src")

        // 🔥 filtrare importantă
        if (!url.startsWith("http")) continue
        if (url.startsWith("data:")) continue
        if (url.endsWith(".svg")) continue

        try {
            val bytes = URL(url).openConnection().apply {
                setRequestProperty("User-Agent", "Mozilla/5.0")
            }.getInputStream().readBytes()

            File("image_$i.jpg").writeBytes(bytes)
            println("Saved image_$i.jpg")

            i++

        } catch (e: Exception) {
            println("Skip: $url -> ${e.message}")
        }
    }
}
